<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Accepted</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: rgb(245, 247, 244);
      font-family: Arial, sans-serif;
      color: rgb(20, 29, 22);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    "
  >
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: rgb(245, 247, 244); padding: 40px 20px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 640px; background-color: rgb(255, 255, 255); border: 1px solid rgb(214, 224, 216); border-radius: 16px; overflow: hidden; box-shadow: 0 8px 24px rgba(20, 29, 22, 0.06);">
            <tr>
              <td style="padding: 32px 32px 24px; border-bottom: 1px solid rgb(214, 224, 216); text-align: left; background: linear-gradient(135deg, rgba(34, 94, 52, 0.12), rgba(34, 94, 52, 0.04));">
                <p style="margin: 0 0 8px; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: rgb(92, 105, 95); font-weight: 700;">MATCHPASS</p>
                <h1 style="margin: 0; font-size: 28px; line-height: 1.15; font-weight: 700; color: rgb(20, 29, 22);">Payment accepted</h1>
              </td>
            </tr>
            <tr>
              <td style="padding: 36px 32px 32px;">
                <h2 style="margin: 0 0 18px; font-size: 22px; line-height: 1.3; color: rgb(20, 29, 22); font-weight: 700;">Hi {{firstName}},</h2>
                <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.7; color: rgb(92, 105, 95);">
                  Your payment for <strong>{{eventName}}</strong> at <strong>{{venue}}</strong> on <strong>{{startAtFormatted}}</strong> has been accepted.
                </p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin: 0 0 24px; background-color: rgb(236, 241, 236); border: 1px solid rgb(214, 224, 216); border-radius: 12px;">
                  <tr>
                    <td style="padding: 18px;">
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: rgb(20, 29, 22); font-weight: 700;">Payment summary</p>
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.7; color: rgb(92, 105, 95);"><strong>Total amount:</strong> Rp{{totalAmount}}</p>
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.7; color: rgb(92, 105, 95);"><strong>Voucher discount:</strong> Rp{{voucherAmount}}</p>
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.7; color: rgb(92, 105, 95);"><strong>Coupon discount:</strong> Rp{{couponAmount}}</p>
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.7; color: rgb(92, 105, 95);"><strong>Points used:</strong> Rp{{pointsAmount}}</p>
                      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: rgb(20, 29, 22); font-weight: 700;"><strong>Final amount:</strong> Rp{{finalAmount}}</p>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin: 0 0 28px; background-color: rgb(34, 94, 52); border-radius: 12px;">
                  <tr>
                    <td style="padding: 20px;">
                      <p style="margin: 0 0 12px; font-size: 18px; line-height: 1.2; color: rgb(248, 250, 248); font-weight: 700;">Your ticket code</p>
                      {{#each tickets}}
                        <p style="margin: 0 0 8px; font-size: 16px; line-height: 1.6; color: rgb(248, 250, 248);">{{code}}</p>
                      {{/each}}
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td align="center">
                      <a href="{{profileUrl}}" style="display: inline-block; padding: 14px 24px; background-color: rgb(210, 82, 32); color: rgb(255, 248, 244); text-decoration: none; border-radius: 10px; font-size: 15px; font-weight: 700;">
                        View in profile
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 32px; border-top: 1px solid rgb(214, 224, 216); text-align: center;">
                <p style="margin: 0; font-size: 13px; line-height: 1.6; color: rgb(92, 105, 95);">
                  Your ticket is now active and ready to be used on match day.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
