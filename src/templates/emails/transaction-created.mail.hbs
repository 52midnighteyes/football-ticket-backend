<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your purchase has been processed</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: rgb(245, 247, 244);
      font-family: Arial, sans-serif;
      color: rgb(20, 29, 22);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      style="background-color: rgb(245, 247, 244); padding: 40px 20px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            style="
              max-width: 640px;
              background-color: rgb(255, 255, 255);
              border: 1px solid rgb(214, 224, 216);
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 8px 24px rgba(20, 29, 22, 0.06);
            "
          >
            <tr>
              <td
                style="
                  padding: 32px 32px 24px;
                  border-bottom: 1px solid rgb(214, 224, 216);
                  text-align: left;
                  background:
                    linear-gradient(135deg, rgba(34, 94, 52, 0.08), rgba(210, 82, 32, 0.08));
                "
              >
                <p
                  style="
                    margin: 0 0 8px;
                    font-size: 13px;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    color: rgb(92, 105, 95);
                    font-weight: 700;
                  "
                >
                  MATCHPASS
                </p>
                <h1
                  style="
                    margin: 0;
                    font-size: 28px;
                    line-height: 1.15;
                    font-weight: 700;
                    color: rgb(20, 29, 22);
                  "
                >
                  Your purchase has been processed
                </h1>
              </td>
            </tr>
            <tr>
              <td style="padding: 36px 32px 32px;">
                <h2
                  style="
                    margin: 0 0 18px;
                    font-size: 22px;
                    line-height: 1.3;
                    color: rgb(20, 29, 22);
                    font-weight: 700;
                  "
                >
                  Hi {{firstName}},
                </h2>
                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: rgb(92, 105, 95);
                  "
                >
                  Your transaction for <strong>{{eventName}}</strong> has been created successfully.
                </p>
                {{#if paymentRequired}}
                <p
                  style="
                    margin: 0 0 24px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: rgb(92, 105, 95);
                  "
                >
                  Please complete your payment before
                  <strong>{{expiredAtFormatted}}</strong>. You can check your ongoing transaction from your profile page.
                </p>
                {{else}}
                <p
                  style="
                    margin: 0 0 24px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: rgb(92, 105, 95);
                  "
                >
                  Your transaction has been fully covered by discounts and points, so no payment is required.
                </p>
                {{/if}}
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                    border-collapse: collapse;
                    margin: 0 0 28px;
                    background-color: rgb(255, 255, 255);
                    border: 1px solid rgb(214, 224, 216);
                    border-radius: 12px;
                    overflow: hidden;
                  "
                >
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Transaction ID</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">{{transactionId}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Event</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">{{eventName}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Venue</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">{{venue}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Start at</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">{{startAtFormatted}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Total amount</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">Rp {{totalAmount}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Voucher amount</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">Rp {{voucherAmount}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Coupon amount</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">Rp {{couponAmount}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;">Points amount</td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(92, 105, 95);">Rp {{pointsAmount}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); background-color: rgb(236, 241, 236); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;"><strong>Final amount</strong></td>
                    <td style="padding: 12px 14px; border: 1px solid rgb(214, 224, 216); font-size: 14px; color: rgb(20, 29, 22); font-weight: 700;"><strong>Rp {{finalAmount}}</strong></td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                    margin: 0 0 28px;
                    background-color: rgb(236, 241, 236);
                    border: 1px solid rgb(214, 224, 216);
                    border-radius: 12px;
                  "
                >
                  <tr>
                    <td style="padding: 18px;">
                      <p style="margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: rgb(20, 29, 22); font-weight: 700;">
                        Next step
                      </p>
                      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: rgb(92, 105, 95);">
                        Open your profile to follow this transaction, upload payment proof if needed, and keep an eye on the status update.
                      </p>
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td align="center">
                      <a
                        href="{{profileUrl}}"
                        style="
                          display: inline-block;
                          padding: 14px 24px;
                          background-color: rgb(210, 82, 32);
                          color: rgb(255, 248, 244);
                          text-decoration: none;
                          border-radius: 10px;
                          font-size: 15px;
                          font-weight: 700;
                        "
                      >
                        Open profile
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                style="
                  padding: 20px 32px;
                  border-top: 1px solid rgb(214, 224, 216);
                  background-color: rgb(255, 255, 255);
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-size: 13px;
                    line-height: 1.6;
                    color: rgb(92, 105, 95);
                  "
                >
                  This message confirms that your MATCHPASS transaction has been created successfully.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
